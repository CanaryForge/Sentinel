# Copiar a .env y ajustar. run_experiment.py sobreescribe RUN_ID/CANARY_TOKEN/CONDITION/TASK por corrida.

# Backend del agente: "ollama" (local, recomendado) u "openai" (endpoint compatible, respaldo)
AGENT_BACKEND=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=16384

# Si AGENT_BACKEND=openai (aqui: plan OpenCode Go, OpenAI-compatible)
# Modelos disponibles en el plan Go: GET https://opencode.ai/zen/go/v1/models
# Nota: desde 2026-09-06 este endpoint exige el header x-opencode-session,
# que agent.py ya agrega automaticamente cuando detecta "opencode.ai" en la base.
OPENAI_API_BASE=https://opencode.ai/zen/go/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-pro

# Inyectadas por el orquestador en cada corrida (valores de ejemplo)
RUN_ID=manual_test_000
CANARY_TOKEN=CNRY-0000000000000000000000
CONDITION=con_harness
TASK=task_01_impossible

# Timeout duro por corrida, en segundos
RUN_TIMEOUT_SECONDS=240

# --- Capa forense: OpenObserve (perfil `forense`, ver docker-compose.yml) ---
# Credenciales del usuario root que OpenObserve crea en el primer arranque.
# Cambiarlas despues del primer arranque NO tiene efecto: quedan grabadas en
# el volumen openobserve-data. Para resetearlas hay que borrar el volumen.
ZO_ROOT_USER_EMAIL=root@sentinel.local
ZO_ROOT_USER_PASSWORD=Complexpass#123
OPENOBSERVE_PORT=5080
# Antiguedad maxima de un evento ingerible, en horas (default de OpenObserve: 5).
# Una linea de tiempo forense son datos viejos por definicion: dejar en 87600.
ZO_INGEST_ALLOWED_UPTO=87600
ZO_INGEST_ALLOWED_IN_FUTURE=87600
